{
  "name": "shera-bot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shera Bot — private prototype monorepo (Pack → Operations → Agents).",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "pnpm": ">=12.4.1 <13.0.0"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck && tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "turbo run build",
    "license:inventory": "node scripts/license-inventory.ts",
    "boundary-guards": "node scripts/boundary-guards.ts",
    "gen:clients": "node scripts/generate-clients.ts",
    "mockup:test": "node --test mockup/dock-layout.test.cjs"
  },
  "devDependencies": {
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "@eslint/js": "10.0.1",
    "@shera-bot/clients": "workspace:*",
    "@shera-bot/contracts": "workspace:*",
    "@types/node": "24.13.5",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "playwright-core": "1.56.1",
    "prettier": "3.9.7",
    "turbo": "2.10.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "zod": "4.6.5"
  }
}
