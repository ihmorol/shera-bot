# Local raw session evidence may contain hidden prompts, tool payloads, or sensitive paths.
.session-archive/

# Temporary archive/extraction helpers.
.session-archive-*.py
.fix-session-history.py

# Local agent-session artifacts (continuation state, temp scripts, plans).
.omo/
.zcode/

# Standalone repo with its own remote; not part of this repository.
/business-landing-portfolio/

# Node / pnpm monorepo build output.
node_modules/
dist/
.next/
.turbo/
coverage/
pnpm-debug.log*
*.tsbuildinfo

# Generated CI output (dependency and license inventory).
artifacts/

# Local review-gate transcripts (gate evidence for a review round; never source).
.review-logs/

# S34 criteria runner scratch: the worktree-local Playwright browser cache
# (the official installer's target — never committed) and the browser-matrix
# run artifacts. The evidence archives under tests/acceptance/evidence/ ARE
# committed; these are tool-owned scratch.
.browsers-cache/
tests/acceptance/browser/test-results/
tests/acceptance/browser/playwright-report/

# S35 deployment: the filled environment file lives ON THE VM only — it is
# the one file in the tree that carries real secrets (G3). .env.example (the
# committed template) carries names only.
infra/deploy/.env
.env
