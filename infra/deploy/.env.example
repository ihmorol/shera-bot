# Shera Bot — deployment environment template (S35).
#
# G3 RULE: this file carries NAMES and placeholder descriptions only — never
# a real key, token, or credential. Copy to .env, fill the values ON THE VM
# (never in a commit, a log, a ticket, or a chat message), and keep .env out
# of Git (the runbook's pre-flight checks `git status` for it).
#
# The compose file REFUSES to render while a required value below is empty
# (${VAR:?} posture) — an unconfigured deployment is a first-class state
# (G4), never a half-secret default.

# ---------------------------------------------------------------------------
# Identity / edge
# ---------------------------------------------------------------------------

# The public hostname that resolves to this VM (automatic HTTPS needs it).
# Production: DOMAIN=shera.example.com and PUBLIC_URL=https://shera.example.com
# Scratch (no DNS yet): leave DOMAIN set to any placeholder name, switch
# CADDYFILE to Caddyfile.local, and set PUBLIC_URL=http://<vm-ip>.
DOMAIN=shera.example.com
PUBLIC_URL=https://shera.example.com

# Which edge Caddyfile mounts: Caddyfile (production TLS) or Caddyfile.local
# (scratch HTTP edge — the runbook's first run).
CADDYFILE=Caddyfile

# Build identity: `git rev-parse HEAD` on the VM (the runbook's exact
# command). Every image is tagged and labeled with this value; the smoke
# script compares the running labels against it.
GIT_SHA=local

# Image tag prefix for the stack's own builds (keep the default).
SHERA_IMAGE_PREFIX=shera-

# ---------------------------------------------------------------------------
# Control plane (Google OAuth is the only login method — PRD §3.2)
# ---------------------------------------------------------------------------

# Auth.js session signing secret — generate ON the VM, never reuse across
# environments: `openssl rand -base64 32`
AUTH_SECRET=

# Google OAuth client for this deployment (Authorized redirect URI:
# https://<DOMAIN>/api/control/api/auth/callback/google — the runbook's
# pre-flight names the exact URI).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Central PostgreSQL (control-plane records — D2/D24)
# ---------------------------------------------------------------------------

# Generate ON the VM: `openssl rand -base64 24` (URL-safe-encode it).
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------
# User runtime containers (the S06 provisioning plane)
# ---------------------------------------------------------------------------

# The image the control plane provisions per account (Dockerfile.user-runtime
# builds it; the runbook's pre-flight builds and tags it with GIT_SHA).
SHERA_RUNTIME_IMAGE=shera-user-runtime:local

# ---------------------------------------------------------------------------
# Backup (central-PG cadence — PRD §12; the user-facing snapshots are the
# runtime's own S33 machinery, not this service)
# ---------------------------------------------------------------------------

# Seconds between central-PG dumps (default 21600 = six hours), how many to
# retain (PRD §12: seven), and the backend: copy (pg_dump into the backups
# volume — the dependency-free default) or restic (the documented EXTERNAL
# binary per E44 — the runbook's DR section; the stack refuses typed when
# restic is not installed, never a silent fallback).
BACKUP_INTERVAL_SECONDS=21600
BACKUP_KEEP=7
BACKUP_BACKEND=copy

# ---------------------------------------------------------------------------
# Monitoring (the alert route to the owner)
# ---------------------------------------------------------------------------

# The webhook the monitor POSTs alerts to (an ntfy/Slack-compatible JSON
# webhook you own). Empty = alerts log to the container only — the runbook's
# monitoring section demonstrates the route with a deliberately failing check.
ALERT_WEBHOOK_URL=

# Backup staleness bound for the monitor's alert (default 25200s = 7h — one
# missed six-hour cadence tick) and the monitor loop interval.
BACKUP_MAX_AGE_SECONDS=25200
CHECK_INTERVAL_SECONDS=60
