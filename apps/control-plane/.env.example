# Control-plane environment references (S05).
# Names only — never commit real values (G3). Generate AUTH_SECRET with
# `openssl rand -hex 32`.

# Central PostgreSQL (D2: control-plane records only).
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DATABASE

# Google OAuth (PRD §3.2: the only login method). Both are required for
# sign-in to be enabled; https://console.developers.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Auth.js session secret (minimum 32 chars).
AUTH_SECRET=

# Public origin of the control plane (pins Auth.js callback URLs and enables
# trusted-host handling in production). Required for deployed environments.
AUTH_URL=

# Public website origin allowed to establish authenticated live connections.
SHERA_WEB_ORIGIN=

# Only for local development without a pinned origin.
# AUTH_TRUST_HOST=true

# S06 runtime provisioning (D12 LocalContainerBackend). The backend applies
# the PRD §3.3 tier limits as real container limits and joins the management
# network only (no published ports, no host mounts).
SHERA_RUNTIME_IMAGE=shera-user-runtime:dev
SHERA_RUNTIME_INTERNAL_PORT=8080
SHERA_RUNTIME_NETWORK=shera-internal
