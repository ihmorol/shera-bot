{
  "tool_id": "tool_web_search",
  "workspace_id": "ws_default_01",
  "version": "1.0.0",
  "name": "Web Search",
  "purpose": "Search the public web for sources.",
  "owner": { "kind": "platform" },
  "inventory_scope": "shared",
  "input_schema": {
    "type": "object",
    "properties": { "query": { "type": "string" } },
    "required": ["query"]
  },
  "output_schema": { "type": "object", "properties": { "results": { "type": "array" } } },
  "capabilities": ["web.read"],
  "risk_class": "READ_ONLY",
  "timeout_ms": 30000,
  "resource_limits": {
    "max_memory_mb": 256,
    "max_cpu_seconds": 10,
    "max_processes": 4,
    "max_disk_mb": 64
  },
  "redaction_policy": "standard",
  "approval_policy": "auto_read_only",
  "recovery": "idempotent_retry",
  "created_at": "2026-09-18T08:00:00.000Z"
}
