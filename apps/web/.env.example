# Server-only control-plane origin. Set it when building and running Next so
# HTTP requests and websocket upgrades stay on the public website origin while
# Next forwards them to the control plane.
CONTROL_PLANE_URL=http://127.0.0.1:3001

# Exact public website origin accepted for browser mutation and live-connection
# Origin checks. Set the same value in the control-plane environment.
SHERA_WEB_ORIGIN=http://127.0.0.1:3000
